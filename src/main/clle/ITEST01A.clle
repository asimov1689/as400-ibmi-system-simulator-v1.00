/* ITEST01A - Integration Test: STATDATA insert path */
/* Pattern: Arrange -> Act -> Assert                  */
PGM
DCL VAR(&MSG)      TYPE(*CHAR) LEN(100)
DCL VAR(&PASSED)   TYPE(*DEC)  LEN(3 0) VALUE(0)
DCL VAR(&FAILED)   TYPE(*DEC)  LEN(3 0) VALUE(0)
DCL VAR(&PASSEDC)  TYPE(*CHAR) LEN(3)
DCL VAR(&FAILEDC)  TYPE(*CHAR) LEN(3)

MONMSG MSGID(CPF0000) EXEC(GOTO CMDLBL(ERRHANDLER))

/* TC-I-01: Insert a new custodian succeeds */
RUNSQL SQL('DELETE FROM CODELIVER1.CUSTODIAN WHERE CUST_ID = ''CU0099''') +
       COMMIT(*NONE) NAMING(*SQL)
RUNSQL SQL('INSERT INTO CODELIVER1.CUSTODIAN +
            VALUES (''CU0099'',''Test Custodian Ltd'',''NYSE'',''US'',''A'')') +
       COMMIT(*NONE) NAMING(*SQL)
MONMSG MSGID(CPF0000) EXEC(DO)
  SNDPGMMSG MSG('TC-I-01 FAIL: insert raised unexpected error')
  CHGVAR VAR(&FAILED) VALUE(&FAILED + 1)
  GOTO CMDLBL(TC2)
ENDDO
SNDPGMMSG MSG('TC-I-01 PASS: new custodian inserted')
CHGVAR VAR(&PASSED) VALUE(&PASSED + 1)

TC2:
/* TC-I-02: Duplicate key is rejected */
RUNSQL SQL('INSERT INTO CODELIVER1.CUSTODIAN +
            VALUES (''CU0099'',''Duplicate'',''LSE'',''GB'',''A'')') +
       COMMIT(*NONE) NAMING(*SQL)
MONMSG MSGID(CPF0000) EXEC(GOTO CMDLBL(DUPCAUGHT))
SNDPGMMSG MSG('TC-I-02 FAIL: duplicate was not rejected')
CHGVAR VAR(&FAILED) VALUE(&FAILED + 1)
GOTO CMDLBL(CLEANUP)

DUPCAUGHT:
SNDPGMMSG MSG('TC-I-02 PASS: duplicate CUST_ID correctly rejected')
CHGVAR VAR(&PASSED) VALUE(&PASSED + 1)

CLEANUP:
RUNSQL SQL('DELETE FROM CODELIVER1.CUSTODIAN WHERE CUST_ID = ''CU0099''') +
       COMMIT(*NONE) NAMING(*SQL)
CHGVAR VAR(&PASSEDC) VALUE(%CHAR(&PASSED))
CHGVAR VAR(&FAILEDC) VALUE(%CHAR(&FAILED))
CHGVAR VAR(&MSG) VALUE('INTEGRATION SUMMARY (ITEST01A): ' *CAT +
                        %TRIM(&PASSEDC) *CAT ' passed, ' *CAT +
                        %TRIM(&FAILEDC) *CAT ' failed')
SNDPGMMSG MSG(&MSG)
GOTO CMDLBL(ENDPGM)
ERRHANDLER: SNDPGMMSG MSG('ITEST01A ERROR - check job log')
ENDPGM: ENDPGM